+int RoundFloatToEvenInt(float v) {
+    const float biased = v + 12582912.0f;
+    std::uint32_t bits;
+    std::memcpy(&bits, &biased, sizeof(bits));
+    return static_cast<int>(bits - 0x4b400000u);
+}
