+// cSC4LandfillZone / cGarbageHeap / SC4CellRegion::Inflate with a fake host. Expected values are derived by hand from
+// the decompiled formulas (0x1000ac9c0..0x1000b011a).
+#include <cmath>
+#include <cstdio>
+#include <map>
+#include <set>
