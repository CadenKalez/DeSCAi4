+    // no seagull effect available
+    Host h2;
+    h2.haveFlock = false;
+    auto* z2 = new cSC4LandfillZone(&h2, FullRegion(0, 0, 3, 3));
+    z2->Init();
+    CHECK(z2->Seagulls() == nullptr && z2->TruckGenerator() != nullptr);
+    z2->Release();
+}
