+std::uint32_t cSC4LandfillZone::AddRef() { return ++refCount_; }
+
+std::uint32_t cSC4LandfillZone::Release() {
+    if (refCount_ < 2) {
+        Shutdown();
+        delete this;
+        return 0;
+    }
+    return --refCount_;
+}
