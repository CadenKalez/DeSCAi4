+// ---- font style script callbacks ----------------------------------------------------------------------------------
+
+// The script command that aliases one font name to another: FO()->vslot 0x98(second, first) — note the swapped order.
+void cSC4App::SetFontAliasStatic(const cRZString& first, const cRZString& second, void* context) {
+    cSC4App* app = static_cast<cSC4App*>(context);
+    if (app && app->fontHooks_.fontSystemAvailable && app->fontHooks_.setFontAlias) app->fontHooks_.setFontAlias(second.ToChar(), first.ToChar());
+}
+
+// The script command that defines a named font style; the context is the application.
+void cSC4App::SetFontStyleStatic(const cRZString& name, const cRZString& specification, void* context) {
+    if (context) static_cast<cSC4App*>(context)->SetFontStyle(name, specification);
+}
+
+// Creates the style from its specification, registers it with the window control manager under the id the creation
+// returned, names it, and adds the name to the font style script vocabulary.
+void cSC4App::SetFontStyle(const cRZString& name, const cRZString& specification) {
+    if (!fontHooks_.fontSystemAvailable || !fontHooks_.createFontStyle) return;
+    std::uint32_t id = 0;
+    cIGZUnknown* style = fontHooks_.createFontStyle(specification.ToChar(), id);
+    if (!style) return;
+    if (fontHooks_.registerStyle && fontHooks_.registerStyle(id, style, name.ToChar()) && fontHooks_.addToVocabulary)
+        fontHooks_.addToVocabulary(name.ToChar(), id);
+    style->Release();
+}
