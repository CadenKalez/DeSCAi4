+
+// ---- saving ------------------------------------------------------------------------------------------------------
+
+namespace {
+// The city file of a save lives next to its predecessor: the data goes to a temp file first, the old file is renamed to
+// "<path>_" while the new one moves into place, and the backup is dropped once the swap worked (or moved back if not).
+constexpr std::uint32_t kMessageSaveBegin = 0x26c63343, kMessageSaveWritten = 0x26c63344, kMessageSaveDone = 0x26c63345,
+                        kMessageSaveStart2 = 0x26c63346;
+constexpr std::uint32_t kVersionRecordType = 0xb7d45e0, kVersionRecordGroup = 0xb7d45e1, kVersionRecordInstance = 0xb7d45e2;
+constexpr std::uint32_t kAppRecordType = 0x49dd6f4c, kAppRecordGroup = 0x49dd6f4e;
+
+bool StringsEqual(const cRZString& a, const cRZString& b) {
+    return a.Strlen() == b.Strlen() && std::memcmp(a.ToChar(), b.ToChar(), a.Strlen()) == 0;
+}
+
+// A save message: segment, temp path, final path and the caller's flag byte (void1 is absent on the "done" message).
+cRZAutoRefCount<cRZMessage2Standard> MakeSaveMessage(std::uint32_t type, cIGZPersistDBSegment* segment, cRZString* tempPath,
+                                                      cRZString* savePath, bool flag) {
+    cRZAutoRefCount<cRZMessage2Standard> message(new cRZMessage2Standard());
+    message->SetType(type);
+    if (segment) message->SetVoid1(segment);
+    message->SetVoid2(tempPath);
+    message->SetVoid3(savePath);
+    message->SetData4(flag ? 1u : 0u);
+    return message;
+}
+}  // namespace
+
+// Saves the current city to `path`. The path actually written is the one SC4CreateSavePathForCity derives from the city's
+// serial number; the file the caller named is removed afterwards when that is a different one. Returns false without a
+// city. On failure the city keeps its old save path; on success the new file is registered as the city segment again and
+// the regional city records of the neighbour connections are rewritten.
+// Quirk kept: the "save begin" message is sent twice (0x26c63343 and 0x26c63346) with the same payload.
+bool cSC4App::SaveCity(const cRZString& path, bool flag) {
+    BusyScope busy(cityHooks_);
+    sc4::cSC4AutoFlushInputMessageQueue flush(1000);
+    sc4::cSC4AutoGamePause pause(false, true, true, true);
+    sc4::cSC4AutoDisableAppSwitching disableSwitching;
+    if (!city_) return false;
+
+    if (cityHooks_.prepareCitySave) cityHooks_.prepareCitySave(city_);
+    const std::uint32_t serial = cityHooks_.citySerialNumber ? cityHooks_.citySerialNumber(city_) : 0;
+    cRZString savePath(cityHooks_.createSavePath ? cityHooks_.createSavePath(serial).c_str() : "");
+    const bool removeNamedFile = !StringsEqual(savePath, path);
+
+    cRZString oldPath;
+    city_->GetCitySaveFilePath(oldPath);
+    city_->SetCitySaveFilePath(savePath);
+
+    cRZString tempPath, backupPath;
+    bool ok = false;
+    if (cRZFile::MakeTempPathName(tempPath, nullptr)) {
+        cRZAutoRefCount<cRZString> tempCopy(new cRZString(tempPath.ToChar()));
+        cRZAutoRefCount<cRZString> saveCopy(new cRZString(savePath.ToChar()));
+        cIGZPersistDBSegment* segment = cityHooks_.createCitySegment ? cityHooks_.createCitySegment() : nullptr;
+        if (segment) {
+            if (segment->Init()) {
+                segment->SetPath(tempPath);
+                if (segment->Open(false, true)) {
+                    cISC4DBSegment* sc4Segment = nullptr;
+                    segment->QueryInterface(sc4::kGZIID_cISC4DBSegment, reinterpret_cast<void**>(&sc4Segment));
+                    cRZAutoRefCount<cRZMessage2Standard> begin = MakeSaveMessage(kMessageSaveBegin, segment, tempCopy.get(), saveCopy.get(), flag);
+                    SendMessage(*begin);
+                    cRZAutoRefCount<cRZMessage2Standard> begin2 = MakeSaveMessage(kMessageSaveStart2, segment, tempCopy.get(), saveCopy.get(), flag);
+                    SendMessage(*begin2);
+                    sc4::SC4WriteAppLoadSaveVersion(segment);
+                    {
+                        // the four module version numbers of the build (always 0xffffffff on the Mac build)
+                        sc4::cSC4AutoSaveStream versionStream(segment, kVersionRecordType, kVersionRecordGroup, kVersionRecordInstance, 3);
+                        cRZVersion version;
+                        const std::uint32_t v0 = version.GetModuleVersion(0u), v1 = version.GetModuleVersion(1u),
+                                            v2 = version.GetModuleVersion(2u), v3 = version.GetModuleVersion(3u);
+                        if (cISC4DBSegmentOStream* stream = versionStream.GetStream()) {
+                            stream->SetUint32(v0);
+                            stream->SetUint32(v1);
+                            stream->SetUint32(v2);
+                            stream->SetUint32(v3);
+                        }
+                    }
+                    bool written = false;
+                    {
+                        sc4::cSC4AutoSaveStream appStream(segment, kAppRecordType, kAppRecordGroup, 1, 1);
+                        if (cISC4DBSegmentOStream* stream = appStream.GetStream()) {
+                            if (Write(*stream, segment)) {
+                                SendMessage(*MakeSaveMessage(kMessageSaveWritten, segment, tempCopy.get(), saveCopy.get(), flag));
+                                SendMessage(*MakeSaveMessage(kMessageSaveDone, nullptr, tempCopy.get(), saveCopy.get(), flag));
+                                written = true;
+                            }
+                        }
+                    }
+                    ok = written && sc4Segment && sc4Segment->SaveClassObjects();
+                    segment->Close();
+                    if (sc4Segment) sc4Segment->Release();
+                }
+                segment->Shutdown();
+            }
+            segment->Release();
+        }
+    }
+
+    UnregisterCityDBSegment();
+    if (ok) {
+        city_->SetCityNameChanged(false);
+        if (cRZFile::FileExists(savePath)) {
+            backupPath = (std::string(savePath.ToChar()) + "_").c_str();
+            if (cRZFile::FileExists(backupPath)) ok = cRZFile::Remove(backupPath);
+            if (ok) ok = cRZFile::Rename(savePath, backupPath);
+        }
+    }
+    if (ok) {
+        if (!cRZFile::Rename(tempPath, savePath)) {
+            cRZFile::Remove(tempPath);
+            if (backupPath.Strlen() != 0) cRZFile::Rename(backupPath, savePath);
+            ok = false;
+        } else if (backupPath.Strlen() != 0) {
+            cRZFile::Remove(backupPath);
+        }
+        if (removeNamedFile && cRZFile::FileExists(path)) cRZFile::Remove(path);
+    }
+    if (tempPath.Strlen() != 0) cRZFile::Remove(tempPath);   // (nothing left after a successful rename)
+
+    city_->SetCitySaveFilePath(ok ? savePath : oldPath);
+    cRZString currentPath;
+    city_->GetCitySaveFilePath(currentPath);
+    RegisterCityDBSegment(currentPath);
+
+    if (!ok) return false;
+    if (cityHooks_.neighborRegionalCities) {
+        for (cISC4RegionalCity* neighbor : cityHooks_.neighborRegionalCities()) {
+            cRZString neighborPath;
+            neighbor->GetCitySaveFilePath(neighborPath);
+            if (neighborPath.Strlen() != 0 && cityHooks_.writeRegionalCityFile) cityHooks_.writeRegionalCityFile(neighborPath.ToChar(), neighbor);
+        }
+    }
+    return true;
+}
+
+// Opens the city file read-only as a database segment and registers it with the resource manager as the city segment.
+void cSC4App::RegisterCityDBSegment(const cRZString& path) {
+    cIGZPersistDBSegment* segment = cityHooks_.createCitySegment ? cityHooks_.createCitySegment() : nullptr;
+    if (!segment) return;
+    segment->Init();
+    segment->SetPath(path);
+    if (!segment->Open(true, false)) {
+        segment->Shutdown();
+    } else {
+        citySegment_ = segment;
+        segment->AddRef();
+        if (SL::spRM) SL::spRM->RegisterDBSegmentBack(*segment);
+    }
+    segment->Release();
+}
+
+// ---- obliteration -----------------------------------------------------------------------------------------------
+
+// Writes the city (through its obliteration save, city vslot 0x368) into a database file at `path`.
+bool cSC4App::SaveCityForObliteration(const cRZString& path) {
+    sc4::cSC4AutoFlushInputMessageQueue flush(1000);
+    sc4::cSC4AutoGamePause pause(false, true, true, true);
+    cIGZPersistDBSegment* segment = cityHooks_.createCitySegment ? cityHooks_.createCitySegment() : nullptr;
+    if (!segment) return false;
+    if (segment->Init()) {
+        segment->SetPath(path);
+        if (segment->Open(false, true)) {
+            if (cityHooks_.saveObliterated && city_) cityHooks_.saveObliterated(city_, segment);
+            segment->Close();
+        }
+        segment->Shutdown();
+    }
+    segment->Release();
+    return true;   // (the original returns nothing meaningful)
+}
+
+// Saves the city to a temp file, closes it (deleting its file!), then re-creates it from the temp file through NewCity with
+// the obliteration segment set and saves it back under its old path. The view's zoom and rotation survive the round trip.
+// Quirk kept: when no temp path can be made the city is closed all the same and the function reports false.
+bool cSC4App::DoCityObliteration() {
+    cRZString tempPath, oldPath;
+    int zoom = 0, rotation = 0;
+    BusyScope busy(cityHooks_);
+    bool result = false;
+    if (cRZFile::MakeTempPathName(tempPath, nullptr)) {
+        result = true;
+        SaveCityForObliteration(tempPath);
+    }
+    if (cityHooks_.getViewZoomAndRotation) cityHooks_.getViewZoomAndRotation(zoom, rotation);
+    if (city_) {
+        city_->GetCitySaveFilePath(oldPath);
+        if (cityHooks_.setCityReloadFlag) cityHooks_.setCityReloadFlag(city_, false);
+    }
+    PartialCloseCity();
+    if (oldPath.Strlen() != 0) cRZFile::Remove(oldPath);
+
+    cIGZPersistDBSegment* segment = cityHooks_.createCitySegment ? cityHooks_.createCitySegment() : nullptr;
+    if (segment) {
+        segment->Init();
+        segment->SetPath(tempPath);
+        if (segment->Open(true, false)) {
+            obliterationSegment_ = segment;
+            NewCity();
+            if (city_) {
+                if (cityHooks_.setCityReloadFlag) cityHooks_.setCityReloadFlag(city_, false);
+                city_->SetCitySaveFilePath(oldPath);
+            }
+            obliterationSegment_ = nullptr;
+            segment->Close();
+            if (city_) SaveCity(oldPath, false);
+        }
+        if (cityHooks_.setViewZoomAndRotation) cityHooks_.setViewZoomAndRotation(zoom, rotation);
+        segment->Shutdown();
+        segment->Release();
+    } else if (cityHooks_.setViewZoomAndRotation) {
+        cityHooks_.setViewZoomAndRotation(zoom, rotation);
+    }
+    cRZFile::Remove(tempPath);
+    return result;
+}
+
+// ---- window messages ----------------------------------------------------------------------------------------------
+
+// The terrain-editor window's "load heightfield" button: window id 0x27df05be, message type 3 with parameter 0x287259f6.
+// Parameter 0x20 (cancel) just ends the dialog; 0x30 runs the file dialog and hands the chosen path to the game's 512-byte
+// path buffer. Returns true for every message of that window/parameter pair, false for anything else.
+bool cSC4App::DoMessage(cIGZWin* window, cGZMessage& message) {
+    if (window->GetID() != 0x27df05be || message.type != 3 || message.param1 != 0x287259f6) return false;
+    if (message.param2 != 0x30) {
+        if (message.param2 == 0x20) RZ::WM()->EndDialog(0xf, window, 0x20);
+        return true;
+    }
+    std::string chosen;
+    if (cityHooks_.chooseHeightField && cityHooks_.chooseHeightField(chosen) && cityHooks_.heightFieldChosen) {
+        if (chosen.size() > 0x1ff) chosen.resize(0x1ff);   // the destination buffer holds 512 bytes
+        cityHooks_.heightFieldChosen(chosen);
+    }
+    return true;
+}
