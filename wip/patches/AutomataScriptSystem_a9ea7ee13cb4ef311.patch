+// cSC4AutomataScriptSystem — loads the automata (vehicles, pedestrians, aircraft, boats) configuration from Lua and keeps
+// the resulting tables. Recovered from Sim City 4 Deluxe Editionsub 1.2.1 (constructor 0x1001d5a90 .. GetGZCLSID
+// 0x1001de310, class id 0x4a1b664e, object size 0x130).
+//
+// Init() registers the system with the advance-time manager, creates the two built-in occupant groups ("vehicle" 0x4002,
+// "pedestrian" 0x4001), runs the script package 0x4a5e8f3f through a private Lua state and publishes the "automata" node of
+// the game-data registry with the commands create_automaton, create_controller, attach_controller,
+// attach_controller_group, detach_controller, detach_controller_group and get_source_building_count.
+// Reading the scripts fills
+//   * controller templates (+0xc8, by name): "attractor" (type 0x6a1628ba) and "generator" (type 0x4a1628c5) tables;
+//   * occupant groups (+0x38 by name, +0x88 by group id, +0xb0 list of the id-0 "special filter" groups) and automata
+//     groups (+0x60 by name) from "automata_group" / "occupant_group";
+//   * the drive-command key map (+0x108, key code -> ePlayerDriveCommand, default 0xd) from a binary table resource;
+//   * the track building group ids (+0xf0).
+// Each group template is reference counted: the name map, the automata map (+0x60) and the id map / special list hold one
+// reference each (CreateOccupantGroup adds them), ClearOccupantGroups releases them. Controller templates are owned by the
+// name map and deleted by ClearTemplates.
+//
+// Original layout of the system: +0x20 initialized, +0x24 refcount, +0x28 Lua state, +0x30 scripts-running flag, then the
+// containers listed above (hash tables use max load factor 1.0).
+//
+// Seams. The original reaches the Lua state through the cISCLua vtable (IAutomataLua here, same slot meaning; the
+// SCLuaHelp::ReadTableField/ReadTableAsArray/... and SCLuaTableRef helpers at 0x1001e61e0..0x1001e78b2 are re-implemented in
+// automata_lua because nothing else recovered provides them), and the other services through SL::sp* globals and
+// GZCOM/RZGetFramework (IAutomataHost). Template classes whose methods live in other address ranges (tControllerTemplate,
+// cSC4OccupantGroupTemplate, tBehaviorTemplate, tKeyEffect) are given the minimal layout this file uses.
+//
+// Quirks kept: the unconditional Pop(1) after walking a global table even when SCLuaTableRef found no table;
+// ImportAttractorTemplates/ImportGeneratorTemplates continue with an existing template of the wrong type after logging
+// it; the attractor "strength" table with no entries dereferences an empty vector in the original (0 is used here);
+// duplicate automata-group names are AddRef'd but not inserted; the behaviour sort uses the original comparison
+// (radius greater OR priority lower), which is not a strict weak order; sCreateAutomaton's ninth parameter is read and
+// dropped; DoMessage(cIGZMessage2*) reads the type and ignores it.
+#pragma once
+#include <cstdint>
+#include <list>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include "gz/cGZPersistResourceKey.h"
+#include "gz/CommandParameterSet.h"
+#include "gz/cIGZIStream.h"
+#include "gz/cIGZMessage2.h"
+#include "gz/cIGZOStream.h"
+#include "gz/cIGZUnknown.h"
+#include "gz/cIGZVariant.h"
+#include "sc4/GameDataRegistry.h"
+#include "sc4/cSC4ResponseCurve.h"
+
+namespace sc4 {
+
+constexpr std::uint32_t kGZCLSID_cSC4AutomataScriptSystem = 0x4a1b664e;
+constexpr std::uint32_t kControllerTypeAttractor = 0x6a1628ba;
+constexpr std::uint32_t kControllerTypeGenerator = 0x4a1628c5;
+constexpr std::uint32_t kAutomataScriptPackage = 0x4a5e8f3f;       // SCLuaHelp::LoadPackageScripts group
+constexpr std::uint32_t kAutomataMessageType = 0x87163754;         // DoMessage(cGZMessage&) accepts exactly this
+constexpr std::uint32_t kAutomataControllerIid = 0x26bb767e;       // iid of the controller objects in script commands
+constexpr std::uint32_t kAutomataAdvanceTimePriority = 0xc0;       // SL::ATM() register/unregister argument
+constexpr std::uint32_t kDriveCommandNone = 0xd;                   // GetDriveCommand default
+constexpr int kDriveCommandCount = 13;
+constexpr std::uint32_t kLuaOpenAllLibraries = 0x7e;
+
+// ---------------------------------------------------------------------------------------------------------------------
+// The Lua state as the system sees it: a subset of the Lua 4 style cISCLua adapter (vtable of cSCLua+0x80). The comment
+// gives the original vslot. Indexes are Lua stack indexes (positive absolute, negative relative to the top).
+class IAutomataLua {
+public:
+    virtual ~IAutomataLua() = default;
+    virtual void Release() = 0;                              // 0x10
+    virtual bool Open(std::uint32_t libraries) = 0;          // 0x18
+    virtual bool Close() = 0;                                // 0x20
+    virtual int GetTop() = 0;                                // 0x30
+    virtual void PushValue(int index) = 0;                   // 0x40
+    virtual void Pop(int count) = 0;                         // 0x58
+    virtual bool IsNumber(int index) = 0;                    // 0x70
+    virtual bool IsString(int index) = 0;                    // 0x78
+    virtual bool IsBoolean(int index) = 0;                   // 0x90
+    virtual std::uint32_t ToUint32(int index) = 0;           // 0xa8
+    virtual std::int32_t ToSint32(int index) = 0;            // 0xb0
+    virtual double ToNumber(int index) = 0;                  // 0xb8
+    virtual const char* ToString(int index) = 0;             // 0xc0
+    virtual void* ToUserTag(int index) = 0;                  // 0xe0
+    virtual bool ToBoolean(int index) = 0;                   // 0xe8
+    virtual void PushNil() = 0;                              // 0xf0
+    virtual void PushNumber(double value) = 0;               // 0xf8
+    virtual void PushString(const char* text) = 0;           // 0x108
+    virtual void GetGlobal(const char* name) = 0;            // 0x128 (pushes the global)
+    virtual void GetTable(int tableIndex) = 0;               // 0x130 (pops the key, pushes table[key])
+    virtual void RawGetI(int tableIndex, int n) = 0;         // 0x140
+    virtual void GetRef(int ref) = 0;                        // 0x158
+    virtual void SetGlobal(const char* name) = 0;            // 0x168 (pops the value)
+    virtual void RawSet(int tableIndex) = 0;                 // 0x178 (pops value and key)
+    virtual int Ref(bool lock) = 0;                          // 0x190 (pops the value)
+    virtual void Unref(int ref) = 0;                         // 0x1f0
+    virtual int Next(int tableIndex) = 0;                    // 0x1f8 (pops key, pushes next key and value; 0 at the end)
+    virtual int GetN(int tableIndex) = 0;                    // 0x200
+    // 0x220: registers one of the two script extensions that SCLuaHelp provides.
+    enum class Extension { Print, DofileFromResource };
+    virtual void Register(Extension which, const char* name) = 0;
+    virtual void PushUserData(void* pointer, int tag) = 0;   // 0x228
+    virtual bool IsTable(int index) = 0;                     // 0x240
+    virtual bool IsNil(int index) = 0;                       // 0x250
+};
+
+// SCLuaHelp::* and SCLuaTableRef (0x1001e61e0..0x1001e78b2), operating on an IAutomataLua.
+namespace automata_lua {
+// ReadTableField overloads: push table[name], read the value, pop. Return whether the field was present (bool overload:
+// whether it was a boolean).
+bool ReadTableField(IAutomataLua& lua, const char* name, float& out, int tableIndex);          // 0x1001e636c
+bool ReadTableField(IAutomataLua& lua, const char* name, std::uint32_t& out, int tableIndex);  // 0x1001e63ee
+bool ReadTableField(IAutomataLua& lua, const char* name, std::int32_t& out, int tableIndex);   // 0x1001e646c
+bool ReadTableField(IAutomataLua& lua, const char* name, bool& out, int tableIndex);           // 0x1001e64ea
+bool ReadTableField(IAutomataLua& lua, const char* name, std::string& out, int tableIndex);    // 0x1001e61e0
+// Pushes table[name] and returns true unless it is nil (nil is popped again).
+bool GetField(IAutomataLua& lua, const char* name, int tableIndex);                            // 0x1001e73c8
+// Array readers: a non-table is read as a one element array; an empty table gives false.
+bool ReadTableAsArray(IAutomataLua& lua, std::vector<std::string>& out, int index);            // 0x1001e6568
+bool ReadTableAsArray(IAutomataLua& lua, std::vector<float>& out, int index);                  // 0x1001e68e8
+bool ReadTableAsArray(IAutomataLua& lua, std::vector<std::uint32_t>& out, int index);          // 0x1001e6a06
+bool ReadTableAsArray(IAutomataLua& lua, std::vector<std::int32_t>& out, int index);           // 0x1001e6b20
+bool ReadTableAsList(IAutomataLua& lua, std::list<std::string>& out, int index);               // 0x1001e6c48
+// {lo, hi} from a number (both) or a two element array (a single element repeats).
+bool ReadTableRange(IAutomataLua& lua, const char* name, float out[2], int tableIndex);        // 0x1001e745e
+bool ReadTableRange(IAutomataLua& lua, const char* name, std::int32_t out[2], int tableIndex); // 0x1001e754c
+
+class TableRef {                                                                                // SCLuaTableRef
+public:
+    TableRef(IAutomataLua& lua, int index);          // 0x1001e763a
+    TableRef(IAutomataLua& lua, const char* global);  // 0x1001e76bc
+    bool begin();                                    // 0x1001e786e: positions on the first entry; false when empty
+    bool next();                                     // 0x1001e78b2
+    bool Done() const { return done_; }
+    int Index() const { return index_; }
+private:
+    IAutomataLua& lua_;
+    std::string name_;
+    int index_ = -1;
+    bool done_ = true;
+};
+}  // namespace automata_lua
+
+// ---------------------------------------------------------------------------------------------------------------------
+// Parameter blocks (tAutomataDriveParams is a 0xa0 byte union of float arrays; the airplane / helicopter / watercraft
+// importers fill it by field offset, the tables below give the Lua names in offset order, index = offset / 4).
+struct AutomataDriveParams {
+    float v[40] = {};
+};
+struct AutomataDriveFieldName { const char* name; int index; };
+extern const AutomataDriveFieldName kAirplaneDriveFields[18];
+extern const AutomataDriveFieldName kHelicopterDriveFields[13];
+extern const AutomataDriveFieldName kWatercraftDriveFields[40];
+
+// tAutomataPlayerDriveParams (0x94 bytes): two ints then floats; v[] index = (offset - 8) / 4.
+struct AutomataPlayerDriveParams {
+    std::int32_t minZoom = 0;        // +0 "MinZoom"
+    std::int32_t startingZoom = 0;   // +4 "StartingZoom"
+    float v[35] = {};
+};
+struct AutomataPlayerFieldName { const char* name; int offset; };
+extern const AutomataPlayerFieldName kPlayerDriveFields[33];   // float fields, "OffRoadTurnAngleRange" (+0x24/+0x28) is separate
+
+struct KeyEffect {              // tKeyEffect (0x80 bytes)
+    std::string fx, bone, controller;
+    std::uint32_t flags = 0;     // 1 hold, 2 one_shot, 4 hard_transition, 8 override, 0x10 has fx, 0x20 has controller
+};
+
+struct BehaviorTemplate {       // tBehaviorTemplate (0x98 bytes)
+    std::uint32_t state = 0;                 // +0
+    float radius = 0.0f;                     // +4
+    float percentage = 1.0f;                 // +8
+    std::uint32_t priority = 1;              // +0xc
+    std::vector<std::string> anims;          // +0x10
+    std::vector<std::uint32_t> sfx;          // +0x28
+    float timeout = 0.0f;                    // +0x40
+    bool finalState = false;                 // +0x44
+    float kphMultiply[2] = {1.0f, 1.0f};     // +0x48
+    std::int32_t kph[2] = {-1, -1};          // +0x50
+    float acceleration = 0.5f;               // +0x58
+    bool ignorePaths = false, ignoreRoads = false, ignoreTerrain = false, ignoreAttractors = false;   // +0x5c
+    bool avoidLots = false, avoidRoads = false;   // +0x60
+    float pathOffset = 0.0f;                 // +0x64
+    float walkDelay[2] = {10.0f, 15.0f};     // +0x68 random_walk.delay
+    float walkTurn[2] = {0.1f, 0.2f};        // +0x70 random_walk.turn
+    float walkStrength[2] = {1.0f, 1.0f};    // +0x78
+    float walkIdleDelay[2] = {0.0f, 0.0f};   // +0x80
+    float walkIdleTime[2] = {5.0f, 10.0f};   // +0x88
+    float deceleration = 0.5f;               // +0x90
+};
+
+// tControllerTemplate: the common part is shared by attractors and generators; the fields after +0x128 differ per type and
+// are kept side by side here.
+struct ControllerTemplate {
+    std::string name;                        // +0x10 (cRZString at +8)
+    std::uint32_t type = 0;                  // +0x30
+    float radius = 0.0f;                     // +0x38
+    cSC4ResponseCurve timeOfDay;             // +0x40
+    std::uint32_t calendar = 0xffffffff;     // +0x60 bit mask of months
+    std::vector<BehaviorTemplate> behaviors; // +0x68
+    std::list<std::uint32_t> effectTriggers; // +0x80
+    std::list<std::uint32_t> deactivateTriggers;   // +0x98
+    float lifetime = 0.0f, delay = 0.0f;     // +0xb0, +0xb4
+    std::uint32_t maxCount = 0;              // +0xb8
+    std::uint32_t lotFlags = 0;              // +0xbc
+    float exclusiveRadius = 0.0f;            // +0xc0
+    std::vector<std::uint32_t> sfx;          // +0xc8
+    std::vector<std::uint32_t> ignoreStates; // +0xe0
+    std::vector<std::uint32_t> groupIds;     // +0xf8 filled by LinkControllerTemplates
+    std::list<std::string> groupNames;       // +0x110 "automata"
+    // attractor only
+    cSC4ResponseCurve strengthCurve;         // +0x128
+    // generator only
+    float countValue = 0.0f;                 // +0x128
+    std::uint32_t countMode = 0;             // +0x12c 0 count, 1 occupancy_pct, 2 population_pct
+    std::int32_t groupCount[2] = {1, 1};     // +0x130
+    float rate = 0.0f;                       // +0x138
+    std::uint32_t rateScale = 0;             // +0x13c
+    std::uint32_t event = 0;                 // +0x140
+    float randomChance = 1.0f;               // +0x144
+    float radiusAlt = 0.0f;                  // +0x148 second "radius" element
+    std::uint32_t lifetimeCount = 0;         // +0x14c
+    std::uint8_t priority = 0;               // +0x150
+};
+
+// cSC4OccupantGroupTemplate (0x120 bytes), reference counted (AddRef slot 1, Release slot 2; created with count 0).
+struct OccupantGroupTemplate {
+    OccupantGroupTemplate* parentHandle = nullptr;   // +0x18 "__group_handle" resolved from the "_parent" reference
+    std::uint32_t groupId = 0;                       // +0x20
+    std::uint32_t classId = 0;                       // +0x24 "class_id"
+    float percentage = 1.0f;                         // +0x40
+    std::list<ControllerTemplate*> controllers;      // +0x48
+    std::unordered_map<std::string, std::uint32_t> anims;   // +0x60
+    std::list<cGZPersistResourceKey> models;         // +0x88
+    std::int16_t selfRef = -2;                       // +0xa0 Lua reference to the group's table
+    std::int16_t parentRef = -2;                     // +0xa2 Lua reference to "_parent"
+    std::list<std::int32_t> trailerGroupIds;         // +0xa8 resolved ids of "trailers"
+    std::list<std::string> trailerNames;             // +0xc0 "trailers" until LinkOccupantGroups
+    float kph[2] = {0.0f, 0.0f};                     // +0xd8
+    AutomataDriveParams* driveParams = nullptr;      // +0xe0 owned
+    AutomataPlayerDriveParams* playerDriveParams = nullptr;  // +0xe8 owned
+    std::uint32_t csiImage = 0;                      // +0xf0
+    std::uint32_t sourceBuilding = 0;                // +0xf4
+    std::unordered_map<std::uint8_t, KeyEffect> keyEffects;  // +0xf8
+
+    OccupantGroupTemplate() = default;
+    OccupantGroupTemplate(const OccupantGroupTemplate&) = delete;
+    OccupantGroupTemplate& operator=(const OccupantGroupTemplate&) = delete;
+    ~OccupantGroupTemplate();
+    std::uint32_t AddRef() { return ++refCount_; }
+    std::uint32_t Release();       // deletes the template when the last reference goes
+    std::uint32_t RefCount() const { return refCount_; }
+private:
+    std::uint32_t refCount_ = 0;
+};
