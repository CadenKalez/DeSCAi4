+// ---------------------------------------------------------------------------------------------------------------------
+// The city's controller manager (SL::spCity vslot 0x178 result).
+class IAutomataControllerManager {
+public:
+    virtual ~IAutomataControllerManager() = default;
+    // vslot 0x28: creates a controller from the named template, attached to `attachTo` (may be null) and placed at `position` (may be null).
+    virtual cIGZUnknown* CreateController(cIGZUnknown* attachTo, const std::string& templateName, const float* position) = 0;
+    virtual void AttachControllerGroup(const std::string& name, cIGZUnknown* controller, int flags) = 0;   // 0x48
+    virtual void DetachController(cIGZUnknown* controller, const std::string& name) = 0;                   // 0x38
+    virtual void DetachControllerGroup(const std::string& name) = 0;                                       // 0x58
+};
