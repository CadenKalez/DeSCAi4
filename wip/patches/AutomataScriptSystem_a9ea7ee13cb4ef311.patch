+// Services replacing SL::sp*, GZCOM and RZGetFramework.
+class IAutomataHost {
+public:
+    virtual ~IAutomataHost() = default;
+    virtual IAutomataLua* CreateLua() = 0;                   // GZCOM class 0xea10c4a2; the caller owns one reference
+    // SCLuaHelp::LoadPackageScripts(lua, group, 0): runs the package's _config.lua; 0 on success, else the Lua error code.
+    virtual int LoadPackageScripts(IAutomataLua& lua, std::uint32_t group, int flags) = 0;
+    virtual sc4::cISC4GameDataRegistry* GameDataRegistry() = 0;   // system service 0xebe0e860 / 0xe898ed03; may be null
+    virtual void RegisterAdvanceTimeTarget(std::uint32_t priority) = 0;     // SL::ATM() vslot 0x28 with the message-target view (+8)
+    virtual void UnregisterAdvanceTimeTarget(std::uint32_t priority) = 0;   // SL::ATM() vslot 0x30
+    virtual IAutomataControllerManager* ControllerManager() = 0;            // SL::spCity vslot 0x178; may be null
+    // cSC4AutomataManager::StaticCreateAutomaton(type, position[3], flags, key, nullptr, 0), followed by the started-notification
+    // (vslot 0x220) on a non-null result.
+    virtual cIGZUnknown* CreateAutomaton(std::uint32_t type, const float position[3], std::uint32_t flags,
+                                         const cGZPersistResourceKey& key) = 0;
+    // The source-building count of building `id` from the vehicle (0), pedestrian (1), aircraft (2) and watercraft (3) manager.
+    virtual std::uint32_t SourceBuildingCount(int manager, std::uint32_t id) = 0;
+    // cSC4AutomataController::CreateTemplateInstance(name, type): null for an unknown type.
+    virtual ControllerTemplate* CreateControllerTemplateInstance(const std::string& name, std::uint32_t type);
+    // The drive-command key table resource {type 0xa2e3d533, group 0x6a231eaa, instance 0x0c0eaad0}: 13 rows of up to 8 key codes.
+    virtual bool OpenDriveCommandKeyTable() = 0;
+    virtual void ReadDriveCommandKeyRow(int row, std::uint32_t keys[8], std::uint32_t& count) = 0;   // count: capacity in, used out
+    virtual void CloseDriveCommandKeyTable() = 0;
+    virtual void Trace(const std::string& message) { (void)message; }   // diagnostics that the original formats into a throwaway string
+};
