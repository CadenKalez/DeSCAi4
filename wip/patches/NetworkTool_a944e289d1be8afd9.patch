+// ReloadNetworkTypeInfo (0x100186f9c): seeds the 13 network type records. `Config` receives what the ini reading
+// (LoadBridgeTypes / LoadSupports / LoadPlacementParams / LoadComplete / LoadTilePatternVerifiers) needs.
+struct NetworkTypeSeed {
+    int type;                       // network type index (the record's slot)
+    std::uint32_t primaryKind;      // first word of the record (1 / 2 / 0)
+    std::uint64_t keyA;             // resource key words seeded into the record
+    std::uint64_t keyB;
+    std::uint64_t keyC;
+    std::uint32_t evaluatorFlag;    // second LoadEvaluator argument
+    const char* bridgeSection;      // ini section for LoadBridgeTypes
+    std::uint32_t bridgeBaseId;     // 0x1000 + ...
+    std::uint32_t bridgeKind;       // last LoadBridgeTypes argument
+    bool loadsSupports;
+    std::uint32_t placementParamsId;
+    bool streetFlag;                // DAT_100b236b5 = 1 for the street record
+};
+extern const NetworkTypeSeed kNetworkTypeSeeds[];
+extern const int kNetworkTypeSeedCount;
+
+class INetworkTypeInfoLoader {
+public:
+    virtual ~INetworkTypeInfoLoader() = default;
+    virtual void Clear(int slot) = 0;
+    virtual void SeedKeys(int slot, const NetworkTypeSeed& seed) = 0;
+    virtual void LoadEvaluator(int slot, bool flag) = 0;
+    virtual void LoadBridgeTypes(int slot, const char* section, std::uint32_t baseId, std::uint32_t kind) = 0;
+    virtual void LoadSupports(int slot, std::uint32_t id) = 0;
+    virtual void LoadPlacementParams(int slot, std::uint32_t id) = 0;
+    virtual void SetStreetFlag(int slot) = 0;
+    virtual void LoadComplete(int slot) = 0;
+    virtual void LoadTilePatternVerifiers(const char* section) = 0;
+};
+void ReloadNetworkTypeInfo(INetworkTypeInfoLoader& loader);   // 0x100186f9c
