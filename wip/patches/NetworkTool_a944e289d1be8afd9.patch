+// cSC4NetworkPreview (the ghost drawn while dragging)
+class INetworkPreview {
+public:
+    virtual ~INetworkPreview() = default;
+    virtual void Clear() = 0;
+    virtual void Erase(const NetPoint& cell) = 0;
+    virtual void AddUntexturedSelection(const NetPoint& cell, std::uint32_t color, const float* heights, float altitude, bool offset) = 0;
+    virtual void AddTexturedSelection(const NetPoint& cell, std::uint32_t color, const float* heights, const cGZPersistResourceKey& texture,
+                                      std::uint8_t rotation, bool flip, float altitude, bool offset) = 0;
+    virtual void AdjustCellHeights(const NetPoint& cell, const float* heights, bool offset) = 0;
+};
+
+// cSC4VertexHtConstraintSatisfier
+class IVertexHeightSatisfier {
+public:
+    virtual ~IVertexHeightSatisfier() = default;
+    virtual void Init(float minHeight, float maxHeight) = 0;
+    virtual void Shutdown() = 0;
+    virtual void InsertFixedVertex(int vertex, float height) = 0;
+    virtual void GetHeight(int vertex, float* out) = 0;
+};
+
+// cSC4NetworkWorldCache (+0x30)
+class INetworkWorldCache {
+public:
+    virtual ~INetworkWorldCache() = default;
+    virtual void Clear() = 0;
+    virtual const NetworkCellInfo* GetCell(std::uint32_t packed) = 0;
+};
