+// cSC4NetworkTool — the network placement tool (roads, rail, highways, pipes, ...). Recovered from Sim City 4 Deluxe
+// Edition 1.2.1 (code 0x1001862bc..0x1001906fc; vtable 0x100a7a928 (cISC4NetworkTool + cIGZUnknown) and 0x100a7abd0
+// (cIGZMessageTarget2 + the neighbourhood callbacks); object size 0x630+; interface ids 1 / 0xa74ca15 (self) and
+// 0x452294aa (message target at +8)). One tool instance exists per network type (eNetworkType, 13 types).
+//
+// Object layout of the original (offsets are kept next to the members below): +0x10 vector (freed in the dtor),
+// +0x28 refcount, +0x2c initialised, +0x30 world cache, +0x80 terrain / +0x88 occupant manager / +0x90 city sub-object
+// (all held with a reference between Init and Shutdown), +0x98 "final placement" flag (false = preview only), +0xa0
+// dragged steps (12 bytes: first cell, last cell, kind), +0xb8 dragged cells, +0xd4 total steps, +0xdc valid steps,
+// +0xe8 set of cells to solve, +0x110 solved cells (12 bytes), +0x128 / +0x138 / +0x150 hash sets (the +0x138 chain
+// holds the cells whose position changed), +0x178 intersections (0x38), +0x190 bridges (0x38), +0x1a8 tunnels (0x10),
+// +0x1c0 additional edge draws (0x14), +0x1d8 view/zoom index, +0x1e0 / +0x1f8 neighbour connections (0x18),
+// +0x210 anchor points, +0x228 / +0x328 vertex height constraint solvers, +0x428 foreign-type mask, +0x430 preview,
+// +0x438 possible bridges, +0x450/+0x454 preferred bridge / altitude override, +0x458 placement mode, +0x45c failure
+// state, +0x460 demolition region, +0x468 highlighted occupants, +0x480 demolition cost, +0x488 cell preview
+// occupants, +0x4a4 cell size, +0x4a8 cell size * tan(slope), +0x4ac/+0x4b0 city cells x/z (+0x4b4/+0x4b8 vertex
+// grid strides), +0x500.. placement parameters copied from the network type info, +0x620 type info, +0x628 network
+// type, +0x62c all-types mask of this tool's family, +0x630 OR filter.
+//
+// Scope: every function of the class' source file between the constructor and ReloadNetworkSpecificInfo. The
+// solver half of the class (SolveNetwork, SmoothenNetwork, GetCellInfo, ComputeDraggedCells, PlaceNetwork,
+// DoAdditionalDraws, ... at 0x1001b..., 0x10071...) is not part of this port and sits behind protected virtual hooks
+// named like the original functions. Services the original reaches through the SL::sp* globals are injected through
+// INetworkToolHost.
+//
+// Quirks kept:
+//  * GetNetworkHeightForTerrainHeight is an identity function (it returns its argument).
+//  * cSC4NetworkTool::Release deletes the tool at a reference count of 1 or less.
+//  * DetermineSupportType starts from 0 and keeps the largest of 2 - (rise < pylon threshold) over all four corners.
+//  * AttemptNeighborConnections returns early (false) in many "cannot connect" cases without clearing the partially
+//    filled local state; it only appends to the two connection lists once every check passed.
+//  * ReloadNetworkTypeInfo seeds hard-coded resource keys / group ids per network type (kept as data tables).
+#pragma once
+#include <cstdint>
+#include <list>
+#include <map>
+#include <memory>
+#include <set>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+#include "gz/cGZPersistResourceKey.h"
+#include "gz/cIGZMessage2.h"
+#include "gz/cIGZString.h"
+#include "sc4/Occupant.h"
+#include "sc4/OccupantManager.h"
+#include "sc4/TileNeighborhood.h"
+
+namespace sc4 {
+
+constexpr int kNetworkTypeCount = 13;
+constexpr std::uint32_t kGZIID_cISC4NetworkTool = 0xa74ca15;
+constexpr std::uint32_t kMessageNetworkToolZoom = 0xa6b79602;   // payload: new view/zoom index (stored at +0x1d8)
+constexpr std::uint32_t kGZIID_cSC4NetworkTunnelOccupant = 0x8a4bd52b;
+constexpr std::uint32_t kGZIID_cSC4NetworkPreBuiltModel = 0x49c1a034;
+constexpr std::uint32_t kGZIID_cSC4NetworkBridgeOccupant = 0x49cc1bcd;
+constexpr std::uint32_t kGZIID_cISC4NetworkOccupant = 0xa821ef94;
+constexpr std::uint32_t kGZIID_cISC4PowerPoleOccupant = 0xa8c86142;
+constexpr std::uint32_t kOccupantTypeNetworkPole = 0x2890d4de;
+constexpr std::uint32_t kExemplarTypeNetworkPiece = 0x6534284a;
+constexpr std::uint32_t kStringGroupNetworkFailure = 0x2a592fd1;
+constexpr std::uint32_t kMessageOccupantDemolishedNotice = 0xaa7a014d;
+
+// ---- data tables (read from the executable) -------------------------------------------------------------------
+extern const std::uint32_t kFlagForNetworkType[kNetworkTypeCount];            // 0x100a19aa0: 1 << type, except type 12 = 0x1000
+extern const std::uint32_t kNetworkPlacementExemplarIDs[kNetworkTypeCount];   // 0x100a19ae0
+extern const float kAltitudeForNetworkType[kNetworkTypeCount];                // 0x100a19b20 (15.5 for 2, 8, 9)
+extern const int kNetworkNextX[4], kNetworkNextZ[4];                          // 0x100a19b60 / 0x100a19b70
+extern const int kNetworkTypeToNeighborConnectionType[kNetworkTypeCount];     // 0x100a19b80
+extern const int kNetworkMultitypePriority[kNetworkTypeCount];                // 0x100a19bc0
+extern const std::uint8_t kEdgesToFixVertex[4];                               // 0x100a19bf4 {3, 9, 0xc, 6}
+
+// ---- data records ---------------------------------------------------------------------------------------------
+struct NetPoint { std::uint32_t x = 0, z = 0; };   // SC4Point<unsigned int>
+
+class INetworkToolOccupant;
+
+// cSC4NetworkCellInfo: what the tool knows about one tile of the placement. Only the fields the tool code touches
+// are named; the rest of the 0xc4+ byte record belongs to the solver.
+struct NetworkCellInfo {
+    std::uint32_t x = 0, z = 0;                  // +0, +4
+    std::uint32_t networkFlags = 0;              // +8 flags of the network types on the tile
+    INetworkToolOccupant* occupant = nullptr;    // +0x10 (reference counted)
+    bool isNewPiece = false;                     // +0x18 costs money (unless freeOfCharge)
+    std::uint32_t hood[kNetworkTypeCount] = {};  // +0x20 packed tile neighbourhood per network type
+    std::uint32_t hoodAll = 0;                   // +0x54 (index 13): the combined neighbourhood
+    std::uint8_t oneWayDirections = 0;           // +0x58
+    bool placed = false;                         // +0x59 the tile got (or keeps) its occupant
+    bool freeOfCharge = false;                   // +0x5a
+    std::uint8_t occupantManagerResult = 0;      // +0x5c
+    bool offsetHeights = false;                  // +0x5e height indices carry the +100000 bridge offset
+    float height[4] = {};                        // +0x60 solved network height at the 4 tile corners
+    float lowLimit[4] = {}, highLimit[4] = {};   // +0x70 / +0x74, stride 8: height constraint per corner
+    std::uint32_t vertex[4] = {};                // +0xb0 terrain vertex index of the 4 corners
+    int solvedIndex = -1;                        // +0xc0 index into the solved cell list (-1 = none)
+};
+
+struct DraggedStep { int firstCell = 0, lastCell = 0, kind = 0; };   // tDraggedStep (12 bytes)
+struct SolvedCell {                                                  // tSolvedCell (12 bytes)
+    std::uint32_t pieceId = 0;       // +0
+    std::uint8_t rotationFlip = 0;   // +4 rotation | flip << 7
+    std::uint32_t cell = 0;          // +8 x | z << 16
+};
+struct Tunnel {                      // tTunnel / tImmovablePortion (16 bytes)
+    float startElevation = 0, endElevation = 0;   // +0 / +4
+    int firstStep = 0, lastStep = 0;               // +8 / +0xc (indices into the dragged steps)
+};
+struct BridgePiece { std::uint32_t data[4] = {}; };   // tBridgePiece (opaque to the tool)
+struct Bridge {                      // tBridge (0x38 bytes)
+    std::uint32_t networkType = 0;   // +0
+    std::uint32_t firstCell = 0, lastCell = 0;   // +4 / +8 (dragged cell indices)
+    int bridgeType = 0;              // +0xc index into the type info's bridge list
+    float altitude = 0;              // +0x10
+    float referenceAltitude = 0;     // +0x14
+    bool isLandBridge = false;       // +0x18
+    std::vector<BridgePiece> pieces; // +0x20
+};
+struct Intersection {                // tIntersection (0x38 bytes)
+    std::uint32_t ruleId = 0;        // +0
+    int x = 0, z = 0;                // +4 / +8
+    std::uint32_t reserved[2] = {};  // +0xc
+    int stepIndex = 0;               // +0x14 compared with the valid step count
+    std::vector<std::uint32_t> cells;// +0x20 solved cell packs covered by the intersection
+};
+struct AdditionalDraw {              // tAdditionalDraw (0x14 bytes)
+    int x = 0, z = 0;
+    std::uint32_t tile = 0, networkType = 0;
+    std::uint8_t edgeA = 0, edgeB = 0;
+};
+struct NeighborConnection {          // tNeighborConnection (0x18 bytes)
+    std::uint32_t cell = 0;          // +0 x | z << 16
+    std::uint32_t edgeMask = 0;      // +4
+    std::uint32_t x = 0, z = 0;      // +8 / +0xc city border position (0xffffffff or the city size = off map)
+    std::uint32_t connectionType = 0;// +0x10
+    bool flag = false;               // +0x14
+};
+struct NeighborConnectionInfo { std::uint32_t x = 0, z = 0, type = 0; bool flag = false; };   // cISC4NetworkTool::NeighborConnectionInfo
+
+struct NetworkBridgeTypeInfo {
+    std::uint32_t bitmapKeyA = 0, bitmapKeyB = 0;   // +0x1b0 / +0x1b4
+    int baseCost = 0;                               // +0x1b8
+    int tileCost = 0;                               // +0x1bc
+    std::string name;                               // +0x1c8
+};
+struct NetworkSupportStructInfo { std::vector<std::uint32_t> pieces; };   // opaque to the tool, handed to AddSupportStructures
+
+// The parts of cSC4NetworkTypeInfo (0x180 bytes per type, static array sNetworkTypeInfo at 0x100b23190) the tool reads.
+struct NetworkTypeInfo {
+    std::uint32_t viewInputControlId = 0;           // +8
+    std::uint32_t exemplarGroup = 0;                // +0xc
+    std::uint32_t cursorId = 0;                     // +0x14
+    std::uint32_t directionalCursorBase = 0;        // +0x18
+    int penWidth = 1, penHeight = 1;                // +0x1c / +0x20
+    std::vector<NetworkBridgeTypeInfo> bridges;     // +0x40 (0x200 bytes each)
+    std::unordered_map<std::uint32_t, NetworkSupportStructInfo> supports;   // +0x58
+    std::uint8_t blockA[0x26] = {};                 // +0x80: placement parameters; the float at +0x98 is the slope angle
+    float slopeAngle = 0;                           // +0x98 (inside blockA in the original)
+    std::vector<std::uint32_t> list528;             // +0xa8
+    float heightTolerance = 0, supportThreshold = 0;// +0xc0 / +0xc4
+    std::uint32_t blockBRest[6] = {};               // +0xc8..+0xdf
+    std::vector<std::uint32_t> tunnelPieceIds;      // +0xe0
+    std::vector<std::uint32_t> tunnelPieceRotations;// +0xf8
+    std::vector<float> tunnelPieceDepth;            // +0x110
+    std::uint32_t blockC0 = 0, blockC1 = 0, blockC2 = 0, blockC3 = 0;   // +0x128..+0x137
+    int bridgeTileCost = 0, tunnelTileCost = 0;     // +0x140 / +0x144 (copied to +0x5c0 / +0x5c4)
+    float heightCostScale = 0;                      // +0x148 (+0x5c8)
+    int demolitionCost = 0;                         // +0x14c (+0x5cc)
+    std::vector<std::uint32_t> list5d0;             // +0x150
+    std::uint32_t tileCost = 0;                     // +0x13c: cost of one new piece
+    std::uint32_t overrideMask = 0;                 // +0x168: bit j = this type may overwrite type j on a shared tile
+};
+
+// cIntRule (nSC4Networks): one highway intersection rule.
+struct IntersectionTileInfo { int pieceOffset = 0; std::uint8_t rotationFlip = 0; };
+class INetworkIntersectionRule {
+public:
+    virtual ~INetworkIntersectionRule() = default;
+    virtual std::uint32_t Id() const = 0;
+    virtual const std::vector<std::pair<int, int>>& PieceOffsets() const = 0;       // +0x78..+0x80: tiles carrying pieces
+    virtual const std::vector<std::pair<int, int>>& FootprintOffsets() const = 0;   // +0x38..+0x40: cells to clear
+    virtual const IntersectionTileInfo* GetTileInfo(int dx, int dz) const = 0;
+    virtual int PieceBase() const = 0;        // +0x14c
+    virtual int PieceStep() const = 0;        // +0x150 (0 = pieces get the stub id 0)
+    virtual int Cost() const = 0;             // +0x12c
+    virtual int GetTypeAtOrigin() const = 0;
+    virtual bool IsInteractive() const = 0;   // +0xd0 string id != 0
+    virtual std::uint32_t PromptStringId() const = 0;   // +0xd0
+    virtual const std::string& EffectName() const = 0;  // +0xe8
+    virtual float EffectOffsetX() const = 0;  // rule+8 -> +8
+    virtual float EffectOffsetZ() const = 0;  // rule+8 -> +0xc
+    virtual std::uint8_t EffectRotation() const = 0;    // rule+8 -> +4
+    virtual bool EffectFlip() const = 0;      // rule+8 -> +5
+};
+
+// ---- service interfaces ---------------------------------------------------------------------------------------
+// A network occupant as the tool sees it (cISC4NetworkOccupant, plus the tunnel / pre built model subclasses; vslots
+// of vtable 0x100a81d38 in the comments).
+class INetworkToolOccupant {
+public:
+    virtual ~INetworkToolOccupant() = default;
+    virtual void AddRef() = 0;                                              // 0x08
+    virtual void Release() = 0;                                             // 0x10
+    virtual void Init(const float (*corners)[3]) = 0;                       // 0x18 the four tile corners
+    virtual bool HasNetworkFlag(std::uint32_t f) = 0;                       // 0x40
+    virtual void SetNetworkFlag(std::uint32_t f) = 0;                       // 0x50
+    virtual void ClearNetworkFlag(std::uint32_t f) = 0;                     // 0x58
+    virtual std::uint32_t GetNetworkFlag() = 0;                             // 0x60
+    virtual void SetUsable(bool on) = 0;                                    // 0xa0
+    virtual bool IsPlaced() = 0;                                            // 0xa8
+    virtual bool IsOfType(int networkType) = 0;                             // 0xb0
+    virtual std::uint32_t PieceId() = 0;                                    // 0xb8
+    virtual std::uint8_t GetRotationAndFlip() = 0;                          // 0xd0
+    virtual void SetQuadDraw(std::uint32_t pieceId, std::uint8_t rotationFlip) = 0;   // 0xf0
+    virtual void SetEdgeTypesFlag(int networkType, std::uint32_t config) = 0;         // 0x128
+    virtual std::uint32_t GetEdgeTypesFlag(int networkType) = 0;                      // 0x130
+    virtual void SetEdgeType(int networkType, int edge, int type) = 0;                // 0x138
+    virtual void SetPathIDOverride(std::uint32_t id) = 0;                   // 0x198
+    virtual float GetAltitude(float x, float z) = 0;                        // 0x1c0
+    virtual void GetNormal(float x, float z, float out[3]) = 0;             // 0x1c8
+    virtual void GetOccupiedCell(std::uint32_t& x, std::uint32_t& z) = 0;   // 0x1d8
+    virtual void SetCostOfDemolition(int cost) = 0;                         // 0x200
+    virtual std::uint8_t GetOneWayDirections() = 0;                         // 0x228
+    virtual void SetOneWayDirections(std::uint8_t d) = 0;                   // 0x230
+    virtual void SetComplexPieceOrigin(int x, int z) = 0;                   // 0x240
+    virtual void GetPosition(float* xyz) = 0;                               // 0x290 (pre built model: the model origin)
+    virtual cISC4Occupant* AsOccupant() = 0;                                // 0x180
+    // subclass access (QueryInterface with the class id succeeds)
+    virtual bool IsPreBuiltModel() = 0;                                     // QI 0x49c1a034
+    virtual void AddModel(std::uint32_t exemplarInstance, const float offset[3], std::uint8_t rotationFlip) = 0;   // AddModel(exemplar,...)
+    virtual void AddSupportModel(std::uint32_t modelId, float rotation, const float offset[3]) = 0;
+    virtual void RecomputeShearTransform() = 0;
+    virtual INetworkToolOccupant* TunnelOtherEnd() = 0;                     // QI 0x8a4bd52b: GetOtherEndOccupant (null when not a tunnel)
+    virtual bool IsTunnel() = 0;
+    virtual void SetTunnelOtherEnd(INetworkToolOccupant* other) = 0;
+};
+
+class INetworkToolTerrain {
+public:
+    virtual ~INetworkToolTerrain() = default;
+    virtual float CellSize() = 0;                                  // 0x30
+    virtual float VertexHeight(std::uint32_t vertex) = 0;          // 0x68
+    virtual void SetVertexHeight(std::uint32_t vertex, float h) = 0;   // 0x188
+    virtual float MaxHeight() = 0;                                 // 0xc0
+    virtual void BeginTerrainEdit() = 0;                           // 0x2b8
+    virtual void ModifyRegion(int a, int b, const std::uint32_t rect[4], int mode) = 0;   // 0x228 (x0, z0, x1, z1)
+    virtual void EndTerrainEdit() = 0;                             // 0x2c0
+};
