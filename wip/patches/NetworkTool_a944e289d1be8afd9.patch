+class INetworkToolHost;
+class NetworkTool;
+
+// The effect shown at a potential highway intersection (cIGZVisualEffect-like).
+class INetworkEffect {
+public:
+    virtual ~INetworkEffect() = default;
+    virtual void SetTransform(const float transform[16], const float extra[4]) = 0;   // vslot 0x38 (placement matrix)
+    virtual void Show(bool immediate) = 0;                                              // vslot 0x18
+    virtual void Hide(bool immediate) = 0;                                              // vslot 0x20
+};
+
+class INetworkToolHost {
+public:
+    virtual ~INetworkToolHost() = default;
+    // singletons
+    virtual INetworkToolTerrain* Terrain() = 0;
+    virtual cISC4OccupantManager* OccupantManager() = 0;
+    virtual int CityCellsX() = 0;                                    // city vslot 0x2e8
+    virtual int CityCellsZ() = 0;                                    // city vslot 0x2f0
+    virtual void* CitySubObject() = 0;                               // city vslot 0x108 (kept, never used)
+    virtual int ViewZoomIndex() = 0;                                 // renderer vslot 0x50 -> +0x14
+    virtual void AddPreviewToRenderer(INetworkPreview* preview, int layer, int priority) = 0;   // renderer 0x100
+    virtual void RemovePreviewFromRenderer(INetworkPreview* preview) = 0;                       // renderer 0x108
+    virtual void AddMessageNotification(NetworkTool* tool, std::uint32_t message) = 0;          // message server 0x28
+    virtual void RemoveMessageNotification(NetworkTool* tool, std::uint32_t message) = 0;       // message server 0x30
+    virtual void PostOccupantDemolished(cISC4Occupant* occupant) = 0;                          // message 0xaa7a014d (data = occupant)
+    // resources
+    virtual bool NetworkExemplarExists(std::uint32_t group, std::uint32_t instance) = 0;       // spRM key {0x6534284a, group, instance}
+    virtual std::unique_ptr<std::uint32_t> FindExemplar(std::uint32_t group, std::uint32_t instance) { (void)group; (void)instance; return nullptr; }
+    virtual bool LoadString(std::uint32_t group, std::uint32_t id, std::string& out) = 0;       // SC4LoadString
+    // network manager / neighbours / demolition
+    virtual const NetworkTypeInfo& TypeInfo(int networkType) = 0;                               // sNetworkTypeInfo[type]
+    virtual NetworkSupportStructInfo* FindSupportInfo(int networkType, std::uint32_t piece) = 0;
+    virtual INetworkIntersectionRule* FindIntersectionRule(std::uint32_t id) = 0;               // sIntersectionRules
+    virtual std::vector<INetworkIntersectionRule*> AllIntersectionRules() = 0;
+    virtual std::uint32_t NetworkTextureInstance(int pieceZoomIndex, std::uint8_t* rotationFlip) = 0;   // NetworkManager vslot 0x68
+    virtual std::vector<cISC4Occupant*> ConnectedStructureOccupants(cISC4Occupant* occupant) = 0;      // NetworkManager vslot 0x60 (AddRef'd)
+    virtual void RemoveNetworkOccupant(NetworkTool* tool, cISC4Occupant* occupant, bool& outBool) = 0;   // NetworkManager vslot 0x40
+    virtual std::unique_ptr<NetworkTool> CreateAuxTool(int networkType, int mode) = 0;           // NetworkManager vslot 0x28 (type 2, 1)
+    virtual void DemolishOccupant(cISC4Occupant* occupant) = 0;      // spDemolition 0x40(1, occ, 1, 0x2001, 0, 0, 0)
+    virtual void DemolishRegion(void* region) = 0;                   // spDemolition 0x30(1, region, 1, 0x2001, 0, filter, ...)
+    virtual int NeighborSimConnectionAt(int connectionType, int x, int z) = 0;                   // neighbours simulator vslot 0x58 (non zero = taken)
+    virtual std::int64_t NeighborSimRegionAt(int x, int z) = 0;      // vslot 0x60
+    virtual void NeighborSimRemoveConnections(int connectionType, std::uint32_t x, std::uint32_t z) = 0;   // vslot 0x38
+    virtual void NeighborSimAddConnection(std::uint32_t type, std::uint32_t x, std::uint32_t z, bool flag) = 0;   // vslot 0x30
+    virtual bool NeighborSimAvailable() = 0;
+    virtual bool CityDrivesOnLeft() = 0;                             // language manager vslot 0x128 -> 0xc8
+    virtual std::int64_t CityBudget() = 0;                           // budget vslot 0x30
+    virtual void SpendBudget(std::int64_t amount) = 0;               // budget vslot 0x40
+    virtual bool ConfirmDialog(const std::string& text) = 0;         // nSC4UI::GenericConfirmationDialog
+    virtual void PlaySound(std::uint32_t id) = 0;                    // sound server vslot 0x50(1, id, 0,0,0)
+    virtual std::unique_ptr<INetworkEffect> CreateEffect(const std::string& name) = 0;           // effects manager vslot 0x30
+    virtual std::unique_ptr<INetworkPreview> CreatePreview() = 0;
+    virtual std::unique_ptr<IVertexHeightSatisfier> CreateHeightSatisfier() = 0;
+    virtual std::unique_ptr<INetworkWorldCache> CreateWorldCache() = 0;
+    virtual std::unique_ptr<INetworkToolOccupant> CreateNetworkOccupant(std::uint32_t occupantClass) = 0;   // new cSC4NetworkOccupant (0 / 0x49c1a034 / 0x49cc1bcd / 0x8a4bd52b)
+    virtual void MarkOccupantsUsable(const std::list<INetworkToolOccupant*>& occupants, bool usable) = 0;   // cSC4NetworkConstructionCrew
+    virtual bool ComputeDemolitionRegion(const std::vector<NetPoint>& cells, void*& region, std::int64_t& cost,
+                                         std::set<cISC4Occupant*>& occupants, cISC4OccupantFilter* filter) = 0;   // cSC4NetworkRoutines
+    virtual void UpdateHighlights(std::set<cISC4Occupant*>& current, std::set<cISC4Occupant*>& wanted) = 0;      // cSC4NetworkRoutines
+    virtual void ReleaseRegion(void* region) = 0;                    // delete the cRZCellMap of the demolition region
+    virtual void IdentifyWaterAndLandBridgeTypes(const std::vector<NetworkBridgeTypeInfo>& bridges, std::vector<int>& water, std::vector<int>& land) = 0;
+    virtual void RegisterStaticShutdown() = 0;                       // spSC4 vslot 0x218(StaticShutdown, 0)
+};
