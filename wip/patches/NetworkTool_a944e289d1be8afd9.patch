+// ---- the tool -------------------------------------------------------------------------------------------------
+class NetworkTool {
+public:
+    NetworkTool(INetworkToolHost& host, int networkType);   // constructor 0x1001862bc
+    virtual ~NetworkTool();                                  // 0x100186748 / 0x100186c34
+
+    // statics (0x100186d04 / 0x100186d3e)
+    static bool StaticInit(INetworkToolHost& host);
+    static void StaticShutdown();
