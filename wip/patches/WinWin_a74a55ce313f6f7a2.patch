+// ---- cGZFadeTmpWin -----------------------------------------------------------------------------------------------
+
+cGZFadeTmpWin::cGZFadeTmpWin(cIGZWinMgr* mgr) : cGZWin(mgr) {
+    auto* v = new cRZVariant();
+    v->AddRef();
+    SetParam(kFadeTmpKey, v);       // marks this window as a fade temporary (PrivateBuffer checks for it)
+    v->Release();
