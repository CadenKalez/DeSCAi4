+// ---- reference counting ------------------------------------------------------------------------------------------
+class IMySimRef {
+public:
+    virtual ~IMySimRef() = default;
+    virtual void AddRef() = 0;
+    virtual void Release() = 0;
+};
+
+// cRZAutoRefCount look-alike: AddRef on copy/assign, Release on reset. A null pointer is allowed everywhere.
+template <class T>
+class MySimRef {
+public:
+    MySimRef() = default;
+    MySimRef(T* p) : p_(p) { if (p_) p_->AddRef(); }                           // takes a new reference
+    MySimRef(const MySimRef& o) : p_(o.p_) { if (p_) p_->AddRef(); }
+    MySimRef(MySimRef&& o) noexcept : p_(o.p_) { o.p_ = nullptr; }
+    MySimRef& operator=(const MySimRef& o) { if (p_ != o.p_) { T* old = p_; p_ = o.p_; if (p_) p_->AddRef(); if (old) old->Release(); } return *this; }
+    MySimRef& operator=(MySimRef&& o) noexcept { if (this != &o) { reset(); p_ = o.p_; o.p_ = nullptr; } return *this; }
+    ~MySimRef() { reset(); }
+    static MySimRef Adopt(T* p) { MySimRef r; r.p_ = p; return r; }               // takes over an owned reference
+    void reset() { T* old = p_; p_ = nullptr; if (old) old->Release(); }
+    T* get() const { return p_; }
+    T* operator->() const { return p_; }
+    explicit operator bool() const { return p_ != nullptr; }
+private:
+    T* p_ = nullptr;
+};
