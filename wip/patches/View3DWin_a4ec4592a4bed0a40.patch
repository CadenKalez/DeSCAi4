+constexpr std::uint32_t kGZCLSID_cSC4View3DWin = 0xfa47b3f9;
+constexpr std::uint32_t kGZIID_cISC4View3DWin = 0xc6ae7085;
+constexpr std::uint32_t kGZIID_cSC4View3DWinAlt = 0x452294aa;   // QueryInterface hands out the pointer at +8
+// messages posted by the view
+constexpr std::uint32_t kView3DMsgScrollBegin = 0xcad61e00, kView3DMsgScrollEnd = 0xead61e16;
+constexpr std::uint32_t kView3DMsgViewFilterChanging = 0x06cdb65a, kView3DMsgViewFilterChanged = 0x06cdb65b;
+constexpr std::uint32_t kView3DMsgViewLevelChanging = 0xc6cdbf1a, kView3DMsgViewLevelChanged = 0xc6cdbf1b;
+constexpr std::uint32_t kView3DMsgInputControlChanged = 0x09c8b8ea, kView3DMsgGlobalEffectTrigger = 0xaa375fe8;
+constexpr std::uint32_t kGZIID_cISC4Occupant = 0x26bb767e;
+constexpr std::uint32_t kGZIID_CostIndicatorBuffer = 0x86d72b57;
+constexpr std::uint32_t kCostIndicatorCursorId = 0xc16c4e1b;     // cursor restored when the control stack empties
+constexpr int kZoomLimitMin = 0, kZoomLimitMax = 5;
+constexpr std::uint32_t kPrefsRenderBoolScrollSimplify = 30;     // SL::spRenderProperties bool #30 (+0x7b8)
+
+// cISC4View3DWin::ViewInputControlStackOperation
+enum ViewInputControlStackOp : int { kStackOpKeep = 0, kStackOpPopCurrent = 1, kStackOpPopAll = 2 };
+
+// A bounding box / owner handed back by the renderer's model pick (vslot 0x200).
+class IPickedModel : public cIGZUnknown {
+public:
+    virtual cIGZUnknown* Owner() = 0;                    // vslot 0x18; the occupant interface is queried from it
+    virtual void GetBounds(float bounds[6]) = 0;         // vslot 0x40: {min xyz, max xyz}; callers pre-fill {1,1,1,0,0,0}
+};
+
+// The camera control (+0x180).
+class IView3DCamera {
+public:
+    virtual ~IView3DCamera() = default;
+    virtual int ZoomLevel() = 0;                         // int at +0x110
+    virtual int VirtualZoom() = 0;                       // GetVirtualZoom (0x10076bbc2): zoom + (float at +0xf8 > threshold)
+    virtual void SetViewTargetPosition(const float xyz[3]) = 0;   // 0x10076bf2a
+};
+
+// The renderer / view object at +0x188.
+class IView3DRenderer {
+public:
+    virtual ~IView3DRenderer() = default;
+    virtual void ScrollEnded() = 0;                      // vslot 0xa0
+    virtual bool SetZoom(int zoom) = 0;                  // vslot 0x118
+    virtual bool ZoomIn() = 0;                           // vslot 0x120
+    virtual bool ZoomOut() = 0;                          // vslot 0x128
+    virtual bool SetRotation(int rotation) = 0;          // vslot 0x130
+    virtual bool RotateLeft() = 0;                       // vslot 0x138
+    virtual bool RotateRight() = 0;                      // vslot 0x140
+    virtual bool SetZoomAndRotation(int zoom) = 0;       // vslot 0x148 (takes only the zoom)
+    virtual bool PickTerrain(int x, int y, float* xyz, int arg, bool flag) = 0;   // vslot 0x1e8
+    virtual bool PickModel(int x, int y, int arg, IPickedModel** out) = 0;        // vslot 0x200
+};
+
+// SL::spCity vslot 0x290: the input gate (tutorial / modal filter) that may veto or rewrite mouse positions.
+class ICityInputGate {
+public:
+    virtual ~ICityInputGate() = default;
+    virtual bool Active() = 0;                           // vslot 0x40
+    virtual bool FilterMouse(int* x, int* y, std::uint32_t mode) = 0;   // vslot 0x80 (mode: -1 down, 1 up, 0 move)
+    virtual bool EdgeScrollAllowed() = 0;                // vslot 0x48 (asked after a successful move filter)
+};
+
+// The sim pauser at +0x238 (vslots 0x50 / 0x68).
+class IViewSimPauser {
+public:
+    virtual ~IViewSimPauser() = default;
+    virtual void Pause() = 0;
+    virtual void Resume() = 0;
+};
+
+// The cost-indicator drawing surfaces: the text buffer (+0x5c0), the on-screen widget (+0x5c8) and the font.
+class ICostIndicatorView {
+public:
+    virtual ~ICostIndicatorView() = default;
+    virtual bool HasWidget() = 0;                        // +0x5c8 != 0
+    virtual bool HasSurface() = 0;                       // +0x5c0 != 0 && +0x5c8 != 0
+    virtual int BufferWidth() = 0;                       // buffer vslot 0x58
+    virtual int BufferHeight() = 0;                      // buffer vslot 0x60
+    virtual bool SetBufferAlpha(std::uint8_t alpha) = 0; // buffer QI 0x86d72b57 -> tint(255, 255, 255, alpha); false when absent
+    virtual void SetOuterArea(int l, int t, int r, int b) = 0;   // widget->window vslot 0x1b8 (SetArea)
+    virtual void SetInnerArea(int l, int t, int r, int b) = 0;   // widget vslot 0x40
+    virtual void ShowWidget() = 0;                       // vslot 0x228
+    virtual void HideWidget() = 0;                       // vslot 0x230
+    virtual bool MeasureText(const std::string& text, int rect[4]) = 0;   // font 0xe2b14587 (else 0x68963c4c) vslot 0x168; false without a font
+    virtual void PrepareBuffer() = 0;                    // if flags 0x8001 set: fill 0, clear the flags
+    virtual bool BeginText() = 0;                        // font vslot 0x1b8
+    virtual void DrawText(const std::string& text, const int rect[4], std::uint32_t color) = 0;   // font vslot 0x1a0 (mode 2, flags 0x8000000)
+    virtual void EndText() = 0;                          // font vslot 0x1c0
+    virtual std::uint32_t MakeColor(std::uint8_t r, std::uint8_t g, std::uint8_t b) = 0;   // graphics system vslot 0x118
+};
+
+// The cursor text widget (+0x5d0) and its sub-window (+8).
+class ICursorTextWidget {
+public:
+    virtual ~ICursorTextWidget() = default;
+    virtual void SetText1(const std::string& s) = 0;     // vslot 0x30
+    virtual void SetText2(const std::string& s) = 0;     // vslot 0x40
+    virtual void SetIcon(void* icon) = 0;                // vslot 0x60
+    virtual void SetPosition(int x, int y) = 0;          // vslot 0x78
+    virtual bool IsShown() = 0;                          // sub-window vslot 0x238
+    virtual void Show() = 0;                             // sub-window vslot 0x228
+    virtual void Hide() = 0;                             // sub-window vslot 0x230
+    virtual void Dismiss() = 0;                          // sub-window vslot 0x2e0
+};
