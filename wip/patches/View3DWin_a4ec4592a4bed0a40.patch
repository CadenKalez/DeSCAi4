+// cSC4View3DWin — the city view window (class id 0xfa47b3f9 / iid 0xc6ae7085, object size 0x6b0; ctor 0x10077efc2,
+// code 0x10077efc2..0x100793e7e). This port covers the view-control core of the class: the view input control stack
+// and persistent list, mouse / key dispatch, scrolling (edge, keyboard and drag), zoom / rotation, view level and filter
+// state, cursor text, the cost indicator, global effect triggers and the last-selected bookkeeping. The GUI builders
+// (AddGUI, ProcessCommand, the panel and menu functions, city init / load / save plumbing) are listed as PARTIAL in
+// notes/ledger_pending/sc4_view3dwin.txt; they only create and drive GZ windows and belong with the UI layer.
+//
+// Layout (the window part is cGZWin at +0x18; the interface vtables sit at +0, +8, +0x10):
+//   +0x180 camera control      +0x188 renderer (cISC43DRender-like: zoom/rotation/pick)   +0x1bc modifier flags of the last event
+//   +0x1c0 key accelerator     +0x1e8/0x1f0/0x1f8 input control stack (vector, top = back)
+//   +0x200/0x208/0x210 persistent input controls   +0x238 sim pauser, +0x248 timer (ms), +0x260 hidden-pause flag
+//   +0x4d8 view filter info    +0x4e0 view level (1)   +0x4e4 scroll angle  +0x4e8 scroll speed  +0x4ec scrolling
+//   +0x4f0 1.0f  +0x4f4 bool  +0x4f5 stop requested  +0x4f8 stop speed  +0x4fc/+0x500 speed multipliers (0.2f edge / keyboard)
+//   +0x504/+0x508 keyboard scroll x / y  +0x50c/+0x510 edge scroll x / y  +0x514/+0x518 right-button press position
+//   +0x51c "mouse moved since press"  +0x520/+0x524 zoom limits (0 / 5)  +0x540 saved render properties
+//   +0x5a0 cost amount, +0x5a4 cost state (0 none, 1 shown, 2 fading), +0x5a8 colour kind, +0x5ac fade timer,
+//   +0x5b0/+0x5b4 cursor position, +0x5b8/+0x5bc fade start position, +0x5c0 text buffer, +0x5c8 cost widget,
+//   +0x5d0 cursor text widget, +0x5d8 cursor text list, +0x5f0 cursor icon, +0x628 contour display, +0x62c contour handle,
+//   +0x678 global effect trigger counts, +0x6a0..+0x6a9 last selected building / lot (value, then "set" flags).
+//
+// Quirks kept: GZOnCharacter's persistent loop is bounded by the size of the *stack*, not of the persistent list;
+// SetZoomLimits clamps against the arguments, not the stored limits; SetZoomAndRotation ignores its second argument;
+// RecalcScrollVelocity loads the edge direction before it clears it (so a mouse-move edge scroll fires once); all the
+// mouse handlers answer true; KeyDown / KeyUp (the window hooks) answer false (ProcessKeyDown / Up do the work).
+// Services behind seams (IView3DHost): city input gate, preferences, render properties, lighting, message server,
+// graphics / font drawing for the cost indicator, cursor text widget; the original uses the SL::sp* globals.
+#pragma once
+#include <cstdint>
+#include <list>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include "gz/WinInterfaces.h"
+#include "gz/cIGZMessage2.h"
+#include "rz/cRZAutoRefCount.h"
+#include "rz/cRZTimer.h"
+#include "sc4/RenderProperties.h"
+#include "sc4/ViewInputControl.h"
+
+namespace sc4 {
