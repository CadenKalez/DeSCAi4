+// SL::TerrainView()->vslot 0x90(0): the overlay layer that draws the contour lines.
+class IContourOverlay {
+public:
+    virtual ~IContourOverlay() = default;
+    virtual std::uint32_t AddContourLayer(std::uint32_t layerId) = 0;   // vslot 0x40 (layer 0x7f94205), returns a handle
+    virtual void RemoveContourLayer(std::uint32_t handle) = 0;          // vslot 0x78
+};
