+// Pieces of the view's persistent state shared with callers.
+struct ViewFilterInformation { cIGZUnknown* filter = nullptr; };       // cSC4ViewFilterInformation (a counted pointer)
+struct ViewLevelInformation { std::int32_t level = 1; };               // cSC4ViewLevelInformation
+enum CursorTextIcon : std::int32_t { kCursorTextIconNone = 0, kCursorTextIconCoverage = 1 };   // value 1 shows the icon at +0x5f0
+
+struct CursorTextInfo {          // 0x70 bytes in the original list node
+    std::uint32_t id = 0;        // +0x10
+    std::uint32_t order = 0;     // +0x14
+    std::string text1;           // +0x18
+    std::string text2;           // +0x40
+    std::int32_t icon = 0;       // +0x68
+};
