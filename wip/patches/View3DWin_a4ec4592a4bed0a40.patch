+// The window part of the view.
+class IView3DWindow {
+public:
+    virtual ~IView3DWindow() = default;
+    virtual void SetCapture() = 0;                       // cGZWin::GZSetCapture
+    virtual bool AmCapturing() = 0;                      // cGZWin::GZAmCapturing
+    virtual void ReleaseCapture() = 0;                   // cGZWin::GZReleaseCapture
+    virtual int Width() = 0;                             // vslot 0x148
+    virtual int Height() = 0;                            // vslot 0x150
+    virtual cIGZCursor* LoadCursor(std::uint32_t id) = 0;        // cursor manager vslot 0x38
+    virtual void ApplyCursor(cIGZCursor* cursor) = 0;            // window vslot 0x2a8 (cursor, 1)
+    virtual bool MouseInWindow(int& x, int& y) = 0;      // window manager vslot 0x110 (window, &x, &y)
+    virtual cIGZWin* AsWin() = 0;                        // AsIGZWin (this + 0x18)
+};
