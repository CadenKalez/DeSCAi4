+// Services behind the SL::sp* globals.
+class IView3DHost {
+public:
+    virtual ~IView3DHost() = default;
+    virtual cIGZMessageServer2* MessageServer() = 0;                     // SL::spMS2
+    virtual void PostMessage2(std::uint32_t type) = 0;                    // SC4PostMessage2(type, 0, 0, 0, 0, nullptr)
+    virtual ICityInputGate* InputGate() = 0;                              // city vslot 0x290 (may be null)
+    virtual bool EdgeScrollPreference() = 0;                              // SL::spPreferences +0xf09
+    virtual bool ExtraZoomLevelEnabled() = 0;                             // spSC4 vslot 0x130 -> +0xf10 (true when the object is absent)
+    virtual bool GraphicsSystemFlag() = 0;                                // SL::spGS vslot 0x60
+    virtual cSC4RenderProperties* RenderProperties() = 0;                 // SL::spRenderProperties == spSC4 vslot 0x160
+    virtual std::uint32_t RenderPropertiesTag() = 0;                      // render properties +0x10
+    virtual void SetRenderPropertiesTag(std::uint32_t tag) = 0;
+    virtual void LightingScrollBegin(float delta) = 0;                    // lighting manager vslot 0x38 (&kColorYellow, 0.1f)
+    virtual void LightingScrollEnd() = 0;                                 // lighting manager vslot 0x40
+    virtual std::int64_t CityBalance() = 0;                               // city vslot 0x1a0 -> vslot 0x30 (0 without a budget)
+    virtual std::string MakeMoneyString(std::int64_t amount) = 0;         // SC4MakeMoneyString
+    virtual cSC4ViewInputControl* NewCityScrollControl() = 0;             // new cSC4ViewInputControlCityScroll (0x60 bytes)
+    virtual void StartCityScroll(cSC4ViewInputControl* control, int x, int y) = 0;   // cSC4ViewInputControlCityScroll::SetMouseScroll
+    virtual IContourOverlay* ContourOverlay() = 0;                        // SL::TerrainView()->vslot 0x90(0), may be null
+    virtual bool ProjectToViewport(float xyz[3]) = 0;                     // SC4ViewUtilities::ProjectPointToViewportCoordinates2D (in place; false when the service is absent)
+};
