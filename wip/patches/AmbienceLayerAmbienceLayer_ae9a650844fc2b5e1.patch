+        ReadTuningValues(instanceId_);
+        RemoveAllFilters();
+        CreateFilters();
+        RemoveLayers();
+        CreateLayers();
+        Enable(!enabled_);     // quirk: two toggles in a row, the net effect is none
+        Enable(!enabled_);
+        return true;
+    }
+    return false;
+}
