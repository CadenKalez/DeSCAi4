+class cSC4PlumbingSimulator {
+public:
+    enum Step : std::uint32_t { kMonthStart = 0, kProduction = 1, kPipeCells = 2, kSelectSource = 3, kDistribute = 4,
+                                kHandOver = 5, kFillGrid = 6, kRefresh = 7, kStatistics = 8, kWait = 9 };
+
+    explicit cSC4PlumbingSimulator(IPlumbingHost* host);
+    ~cSC4PlumbingSimulator();   // 0x10009bf2c
+    cSC4PlumbingSimulator(const cSC4PlumbingSimulator&) = delete;
+    cSC4PlumbingSimulator& operator=(const cSC4PlumbingSimulator&) = delete;
+
+    // ---- COM glue ----
+    std::uint32_t GetGZCLSID() const { return kGZCLSID_cSC4PlumbingSimulator; }   // 0x1000a1284 / 0x1000a1290 (thunk)
+    // 0 not supported; 1 primary view, 2 message target view (+8), 3 serializable view (+0x10)
+    int QueryInterfaceView(std::uint32_t iid);
+    std::uint32_t AddRef() { return ++refCount_; }
+    std::uint32_t Release();   // at the last reference: Shutdown() and delete this
+
+    // ---- lifecycle ----
+    bool Init();
+    bool Shutdown();
+    void ReadSimulatorTunableValues();
+
+    // ---- messages ----
+    bool DoMessage(IPlumbingMessage& message);
+    bool DoIdle(std::uint32_t budget);
+    void DoOccupantInserted(IPlumbingOccupant* occupant);
+    void DoOccupantRemoved(IPlumbingOccupant* occupant);
+    void DoPipeChanged(IPlumbingPipe* pipe, bool added);
+    void DoBuildingChanged(IPlumbingOccupant* occupant, bool added);
+
+    // ---- monthly steps ----
+    void ApplyPipeFunding(const SC4Percentage& funding);
+    void UpdateWaterProduction();
+    void AgeWaterProducer(WaterProducer& producer);
+    int BuildingConsumption(int x, int z);
+    void FillGridAtOccupant(cSC4SimGrid<std::uint8_t>* grid, IPlumbingOccupant* occupant, std::uint8_t value);
+    void GetConnectionCell(IPlumbingConnection* connection, int& x, int& z);
+    bool IsNeighborConnectedToCurrentNetwork(void* city, bool markConnections);
+    // Distance ring of the nearest water cell within `radius` (spiral search), -1 when none, 0 for kWaterSourceNone.
+    int NearestWater(int x, int z, int sourceType, int radius);
+
+    // ---- queries ----
+    bool GetOccupantMonthlyUpkeepCost(IPlumbingOccupant* occupant, std::int64_t& cost);
+    // Least funded budgeted producer (funding < 2.0) and the producer with the highest wear ratio; outputs optional.
+    void FindWaterBuildings(IPlumbingOccupant** leastFunded, SC4Percentage* funding, IPlumbingOccupant** mostWorn, int* wearPercent);
+    void GetWaterProducers(std::vector<IPlumbingOccupant*>& out);   // adds a reference to each
+    std::uint8_t GetSupplyValue(int x, int z) const;                // 0x1000a076a: tail call into the watered grid
+    void GetSupplyValueMapPtr(cSC4SimGrid<std::uint8_t>*& out) const { out = wateredGrid_; }
+    bool AreWateredBuildingsInCell(int x, int z) const;
+    bool IsBuildingWatered(IPlumbingOccupant* occupant);
+    std::uint32_t GetWaterProduction(IPlumbingOccupant* occupant) const;
+    bool IsCellWatered(int x, int z) const;
+    bool GetWaterProducerInfo(IPlumbingOccupant* occupant, std::uint32_t* production, std::uint32_t* capacity,
+                              SC4Percentage* fraction, bool* polluted, std::uint32_t* currentProduced) const;
+    bool GetWaterProducerConditionPercent(IPlumbingOccupant* occupant, SC4Percentage& out);
+    std::uint32_t GetWaterDemand() const { return static_cast<std::uint32_t>(waterDemand_); }
+    cSC4SimGrid<std::uint8_t>* GetWateredGrid() const { return wateredGrid_; }
+    std::uint32_t GetNumWaterSources() const { return static_cast<std::uint32_t>(producers_.size()); }   // +0x120 (kept in step)
+    std::uint32_t GetNumPollutedWaterSources() const { return pollutedSources_; }
+    std::uint32_t GetWaterProductionCapacity() const { return static_cast<std::uint32_t>(publishedCapacity_); }
+    std::uint32_t GetWaterConsumed() const { return static_cast<std::uint32_t>(publishedConsumed_); }
+    std::uint32_t GetWaterImported() const { return static_cast<std::uint32_t>(publishedImported_); }
+    std::uint32_t GetWaterExported() const { return static_cast<std::uint32_t>(publishedExported_); }
+    std::uint32_t GetNumPipes() const { return numPipes_; }
+    std::uint32_t GetNumDistressedPipes() const { return numDistressedPipes_; }
