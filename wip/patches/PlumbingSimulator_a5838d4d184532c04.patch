+// One water producer (WaterProducer, 0x38 bytes; list node 0x48: prev/next + record).
+struct WaterProducer {
+    int x = 0, z = 0;                       // +0, +4 reference cell
+    int minX = 0, minZ = 0, maxX = 0, maxZ = 0;   // +8..+0x14 lot rectangle (inclusive)
+    bool visited = false;                   // +0x18 reached by the flood fill this round
+    bool outputStored = false;              // +0x19 current produced amount written back
+    std::uint32_t capacity = 0;             // +0x1c maximum output (property 0x88ed3303)
+    std::int32_t production = 0;            // +0x20 output after the source, funding and pollution factors
+    float productionFraction = 0.0f;        // +0x24
+    bool polluted = false;                  // +0x28
+    IPlumbingOccupant* occupant = nullptr;  // +0x30
+};
