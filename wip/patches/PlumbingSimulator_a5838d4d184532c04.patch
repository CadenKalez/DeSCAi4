+constexpr std::uint32_t kPlumbingPipeIid = 0x49c05b9f, kPlumbingBudgetItemIid = 0x87dda3a9, kPlumbingDealIid = 0x0773fef1;
+constexpr std::uint32_t kPlumbingDealImport = 0x4773ffe2, kPlumbingDealExport = 0x4773ffe3;   // see DoIdle step 3/4
+// exemplar properties
