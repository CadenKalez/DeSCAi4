+                        kPlumbingWear = 0xc910b4cf, kPlumbingSourceType = 0x48f23a7e, kPlumbingConditionCurve = 0x8a1e07ee,
+                        kPlumbingWearRate = 0xea1cf220, kPlumbingWearWarn = 0xea1cf221, kPlumbingWearCritical = 0xea1cf222,
+                        kPlumbingBudgetProperty = 0xca58c9d5, kPlumbingStoredCost = 0x2a58d350, kPlumbingUnitCost = 0xea1e3c53,
+                        kPlumbingCostCurve = 0x0911e2e7;
+// pipe flags (cSC4PipeOccupant vslot 0x60)
+constexpr std::uint32_t kPipeFlagDistressed = 0x10000, kPipeFlagBurst = 0x20000, kPipeFlagGhost = 0x80000000;
+// cell flags
+constexpr std::uint8_t kCellLinkWest = 0x01, kCellLinkNorth = 0x02, kCellLinkEast = 0x04, kCellLinkSouth = 0x08, kCellPipe = 0x10,
+                       kCellProducer = 0x20, kCellConsumer = 0x40;
+// WaterSourceType (property 0x48f23a7e): how the producer is checked against nearby water
+enum WaterSourceType : int { kWaterSourceNearby = 0, kWaterSourceRequired = 1, kWaterSourceNone = 2 };
