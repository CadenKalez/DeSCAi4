+// SpiralIterator-style walk of the cell scan iterator (+0x1b0): shared by steps 2, 6 and 7.
+bool ScanIteratorNext(ScanningIterator& it, int& x, int& z);
+void ScanIteratorReset(ScanningIterator& it);
