+class cSC4Vehicle;
+
+// The cSC4TrafficAutomaton / cSC4Automaton code the vehicle chains to or dispatches into.
+class IVehicleBase {
+public:
+    virtual ~IVehicleBase() = default;
+    // direct base-class calls made by the vehicle's overrides
+    virtual bool BaseInit(cSC4Vehicle& v) = 0;                               // cSC4TrafficAutomaton::Init
+    virtual std::uint32_t BaseShutdown(cSC4Vehicle& v) = 0;                  // cSC4TrafficAutomaton::Shutdown
+    virtual std::uint32_t BaseDoAnimationTick(cSC4Vehicle& v, std::uint32_t a, float dt) = 0;
+    virtual bool BaseDoStateTick(cSC4Vehicle& v, float dt) = 0;
+    virtual bool BaseStartTrip(cSC4Vehicle& v, IVehicleNetworkOccupant* occupant, std::uint32_t key, bool flag) = 0;
+    virtual void BaseHandleEnterState(cSC4Vehicle& v, AutomataState* state) = 0;
+    virtual void BaseHandleNetworkOccupantRemoved(cSC4Vehicle& v) = 0;
+    virtual float BaseGetSpeedModifier(cSC4Vehicle& v) = 0;                  // cSC4Automaton::GetSpeedModifier
+    virtual bool BaseWrite(cSC4Vehicle& v, cIGZOStream& s) = 0;
+    virtual bool BaseRead(cSC4Vehicle& v, cIGZIStream& s) = 0;
+    virtual bool BaseDoPlayerDriveTick(cSC4Vehicle& v, float dt) = 0;        // cSC4Automaton::DoPlayerDriveTick
+    virtual bool BaseTranslatePlayerDriveCommands(cSC4Vehicle& v, PlayerDriveState* s, float dt) = 0;
+    virtual void BaseHandlePlayerDriveCommand(cSC4Vehicle& v, int command, bool pressed) = 0;
+    virtual void BaseDoCollideTick(cSC4Vehicle& v, float dt) = 0;
+    virtual void RemoveModelInstance(cSC4Vehicle& v, IVehicleModelInstance* instance) = 0;   // cSC4Automaton::RemoveModelInstance
+    // vslot calls into code the vehicle inherits unchanged
+    virtual void Remove(cSC4Vehicle& v, bool flag) = 0;                      // vslot 0x68
+    virtual void MoveTo(cSC4Vehicle& v, const cS3DVector3* position, const cS3DVector3* direction) = 0;   // vslot 0x80
+    virtual void SendCallbackMessage(cSC4Vehicle& v, int event, std::uint32_t data) = 0;   // vslot 0x368
+    virtual bool PushState(cSC4Vehicle& v, int stateId, int a, int b, int c, int d, int e, float duration) = 0;   // vslot 0x1a0
+    virtual void StartNamedEffects(cSC4Vehicle& v, const char* name, int a, bool b) = 0;   // vslot 0x160
+    virtual void StopNamedEffects(cSC4Vehicle& v, const char* name, int a) = 0;            // vslot 0x168
+    virtual void UpdateCollision(cSC4Vehicle& v) = 0;                        // vslot 0x540
+    virtual void UpdateAllEffects(cSC4Vehicle& v) = 0;                       // vslot 0x438 (UpdateGhostModel)
+    virtual AutomataState* FindState(cSC4Vehicle& v, int id) = 0;            // vslot 0x1c8
+    virtual const AutomataGroup* GetAutomataGroup(cSC4Vehicle& v) = 0;       // vslot 0x218
+    virtual void LoadAuxiliaryModel(cSC4Vehicle& v, int kind, IVehicleModelInstance*& out) = 0;   // vslot 0x350
+    virtual bool InterpolateAlongPath(cSC4Vehicle& v, float distance, const cS3DVector3* from, cS3DVector3* out, int* index,
+                                      const std::vector<cS3DVector3>* path, float* position) = 0;   // vslot 0x460
+    virtual void ChooseLookaheadPath(cSC4Vehicle& v, IVehicleNetworkOccupant* occupant, const cS3DVector3* at,
+                                     std::uint8_t* lane, int flag) = 0;      // vslot 0x590 (GetEdgeFromVector)
+    virtual void ApplyPath(cSC4Vehicle& v, IVehicleNetworkOccupant* occupant, std::uint32_t key,
+                           const std::vector<cS3DVector3>* path, bool flag) = 0;   // vslot 0x458 (SetPath)
+    virtual IVehicleLeader* FindLeader(cSC4Vehicle& v) = 0;                  // vslot 0x4d8
+    virtual void RegisterWithNetwork(cSC4Vehicle& v, IVehicleNetworkOccupant* old) = 0;   // trafficAutomataManager vslots 0xf0/0xf8
+    virtual float GetStopPointOffset(cSC4Vehicle& v) = 0;                    // helper for GetSafeDistance's unresolved tail
+};
