+    virtual bool DisasterLayerActive() = 0;                                  // disaster layer vslot 0x50
+    virtual float DisasterDamageAt(int cx, int cz) = 0;                      // disaster layer 0xc4c90997 -> 0xa9b5ab9e iface vslot 0x28
